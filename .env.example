# Copy to .env (git-ignored) and adjust. Every variable is optional.
VRAG_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
VRAG_LOG_FORMAT=json         # json | console
VRAG_DATA_DIR=data
VRAG_RESULTS_DIR=results

# Gemini key for drafting (RAG-M4) and /answer (RAG-M7); server-side only, never commit it:
# VRAG_GEMINI_API_KEY=
